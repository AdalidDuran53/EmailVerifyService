@using Domain
@model VerificationModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Bienvenido - Verificación de correo</title>
</head>
<body style="margin:0; padding:0; font-family: Arial, sans-serif; background-color:#f4f4f4;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f4f4">
        <tr>
            <td align="center" valign="top" style="padding:40px 0;">
                <table width="500" cellpadding="0" cellspacing="0" border="0"
                       style="background-color:#ffffff; border:4px solid #2c3e50; border-radius:12px;">
                    <tr>
                        <td align="center" style="padding:30px;">
                            <h1 style="color:#2c3e50; margin:0; font-size:24px; font-weight:bold;">¡Bienvenido!</h1>
                            <p style="color:#555; font-size:16px; margin:20px 0;">
                                Gracias por registrarte en nuestra plataforma.<br />
                                Para completar tu proceso de verificación, utiliza el siguiente código:
                            </p>
                            <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin:20px auto;">
                                <tr>
                                    <td align="center" bgcolor="#eaf2f8"
                                        style="color:#1a5276; font-size:32px; font-weight:bold; letter-spacing:6px; padding:20px 40px; border:2px dashed #1a5276; border-radius:8px;">
                                        @Model.Code
                                    </td>
                                </tr>
                            </table>

                            <p style="color:#777; font-size:14px; margin-top:20px;">
                                Este código expirará en <strong>@Model.ExpirationMinutes minutos</strong>.
                            </p>
                            <p style="color:#999; font-size:12px; margin-top:30px;">
                                Si no solicitaste esta verificación, puedes ignorar este mensaje.
                            </p>
                            <p style="color:#b0b0b0; font-size:11px; margin-top:20px; font-style:italic;">
                                Este correo se generó automáticamente, por favor no respondas a este mensaje.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
